APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
CURRENCY=usd

# Database. Default is a file-based SQLite database for dev and test.
# DB_DRIVER=mysql or pgsql opens a server connection with the values below,
# but the shipped migrations are written for SQLite.
DB_DRIVER=sqlite
DB_DATABASE=database/bazaar.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Stripe test-mode keys. Grab them from https://dashboard.stripe.com/test/apikeys
# Leave the placeholders in place to run the shop with payments disabled.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Outgoing mail. MAIL_DRIVER=log appends every message to storage/logs/mail.log.
# MAIL_DRIVER=smtp delivers through the server below. MAIL_ENCRYPTION is tls
# (STARTTLS, usually port 587), ssl (implicit TLS, usually port 465) or none.
# Leave MAIL_USERNAME empty to skip SMTP authentication.
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=orders@bazaar.test
