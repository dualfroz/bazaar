APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
CURRENCY=usd

# Database. Default is a file-based SQLite database for dev and test.
# For MySQL/Postgres on deploy set DB_DRIVER=mysql or pgsql and fill the rest.
DB_DRIVER=sqlite
DB_DATABASE=database/bazaar.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# Stripe test-mode keys. Grab them from https://dashboard.stripe.com/test/apikeys
# Leave the placeholders in place to run the shop with payments disabled.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
